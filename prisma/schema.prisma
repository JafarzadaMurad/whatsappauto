generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// System-wide config (Meta App credentials, etc.)
model SystemConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ─── Workspaces ──────────────────────────────────────────────────
// Every user owns a personal workspace and can be a member of other
// workspaces (e.g. invited by someone else). All "tenant" data
// (instances, automations, clients, etc.) is scoped by workspaceId.
model Workspace {
  id      String  @id @default(uuid())
  name    String
  ownerId String
  owner   User    @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Subscription + plan apply at the workspace level. Members of a
  // workspace use the owner's plan; their own plan is irrelevant inside
  // someone else's workspace.
  planId               String?
  plan                 Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptionStatus   String    @default("none") // none | trialing | active | past_due | canceled
  subscriptionEndsAt   DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]

  instances         Instance[]
  webhooks          WebhookConfig[]
  apiKeys           ApiKey[]
  aiProviders       AiProvider[]
  agents            Agent[]
  customTables      CustomTable[]
  clients           Client[]
  campaigns         Campaign[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  userFields        UserField[]
  automationExecutions AutomationExecution[]
  mcpClients     McpClient[]
  mcpOAuthTokens McpOAuthToken[]
  mcpPermission  McpPermission?
  mcpAuditLogs   McpAuditLog[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  role        String   @default("MEMBER") // OWNER | ADMIN | MEMBER | VIEWER
  createdAt   DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String   @default("MEMBER")
  token       String   @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([email])
}

// Subscription plans (managed by admins)
model Plan {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text

  price    Float  @default(0)      // amount per billing interval
  currency String @default("USD")
  interval String @default("month") // month | year

  // Resource limits (-1 = unlimited)
  maxAgents            Int @default(1)
  maxWhatsappAccounts  Int @default(1)
  maxInstagramAccounts Int @default(1)
  maxAutomations       Int @default(1)
  monthlyMessageLimit  Int @default(1000)

  isActive      Boolean @default(true)
  isDefault     Boolean @default(false) // assigned to new sign-ups (only one plan can be default; must have price = 0)
  trialDays     Int?    // duration of the free plan in days; null = no expiry

  stripePriceId String? // Stripe Price ID (set when billing is wired up)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  workspaces Workspace[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?  // null for users who signed in via Google
  name      String?
  role      String   @default("USER") // USER | ADMIN
  googleId  String?  @unique // Google "sub" claim for OAuth sign-in

  // Email verification + password reset
  emailVerified        Boolean   @default(false)
  emailVerifyToken     String?   @unique
  emailVerifyExpires   DateTime?
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Subscription
  planId               String?
  plan                 Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptionStatus   String    @default("none") // none | trialing | active | past_due | canceled
  subscriptionEndsAt   DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?

  instances Instance[]
  webhooks  WebhookConfig[]
  apiKeys   ApiKey[]

  // AI & CRM Links
  aiProviders  AiProvider[]
  agents       Agent[]
  customTables CustomTable[]
  clients      Client[]
  campaigns         Campaign[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  userFields        UserField[]

  // MCP
  mcpClients     McpClient[]
  mcpOAuthTokens McpOAuthToken[]
  mcpPermission  McpPermission?
  mcpAuditLogs   McpAuditLog[]

  // Workspaces
  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
}

model Instance {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  name        String
  status      String  @default("DISCONNECTED") // CONNECTED, DISCONNECTED, CONNECTING
  sessionData String? @db.Text // Can store some meta-info, actual baileys state might be stored elsewhere or here piece by piece

  // When true, on the next link/restart Baileys requests the full chat
  // history from the phone and we store the incoming messages.
  syncHistory Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]
  contacts  Contact[]
  webhooks  WebhookConfig[]
  campaigns Campaign[]
}

model ApiKey {
  id          String @id @default(uuid())
  key         String @unique
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model WebhookConfig {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  instanceId String? // Optional: if null applies to all, otherwise specific to instance
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  url      String
  events   String[] // e.g. ["message.new", "message.sent"]
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id         String   @id @default(uuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  remoteJid   String // The WhatsApp ID of the chat/contact
  isFromMe    Boolean
  messageType String // text, image, video, document, etc
  content     String? @db.Text

  status String @default("SENT") // PENDING, SENT, DELIVERED, READ

  timestamp DateTime
  createdAt DateTime @default(now())
}

model Contact {
  id         String   @id @default(uuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  remoteJid String
  name      String?
  pushName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instanceId, remoteJid])
}

// Maps a WhatsApp LID (anonymous identity like 231610725195937@lid) to
// the real phone JID the contact also uses. WhatsApp delivers `senderPn`
// on some messages from LID-only contacts — when we see one we cache
// the mapping here so subsequent messages, the inbox merge step, and
// the CRM can all route to the real phone instead of leaving two
// duplicate conversations side by side.
model LidMapping {
  id         String   @id @default(uuid())
  instanceId String
  lid        String   // e.g. "231610725195937@lid"
  phone      String   // digits only, e.g. "994773102993"
  createdAt  DateTime @default(now())

  @@unique([instanceId, lid])
  @@index([instanceId, phone])
}

// Model for Baileys Auth State
model AuthState {
  id         String   @id @default(uuid())
  instanceId String   @unique
  data       String   @db.Text // JSON string containing creds
  updatedAt  DateTime @updatedAt
}

model AuthKey {
  id         String   @id // Formatted as instanceId_type_id
  instanceId String
  type       String
  keyId      String
  data       String   @db.Text // JSON string containing the key
  updatedAt  DateTime @updatedAt

  @@unique([instanceId, type, keyId])
}

// -----------------------------------------
// AI Chatbot & Intelligent CRM CRM Models
// -----------------------------------------

model AiProvider {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  provider String // OPENAI, CLAUDE, GEMINI
  apiKey   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agents Agent[]

  @@unique([userId, provider])
  @@index([workspaceId])
}

model Agent {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name       String
  providerId String
  provider   AiProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  model      String // e.g. "gpt-4o", "claude-3-opus"

  systemPrompt    String?  @db.Text
  allowedTableIds String[] // IDs of CustomTable models this agent can access
  skills          String[] // e.g. ["crm", "tables", "http", "memory"]
  allowedUrls     String[] // URL patterns the generic httpRequest tool can call
  httpTools       Json     @default("[]") // Array of HttpToolTemplate (n8n-style structured HTTP tools)
  skillPrompts    Json     @default("{}") // Per-skill prompt overrides: { memory?: string, crm?: string, ... }
  isActive        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instances         Instance[] // Instances using this agent
  conversationLogs  AiConversationLog[]
  activityLogs      AgentActivityLog[]
  campaigns         Campaign[]
  instagramAccounts InstagramAccount[]
}

model AiConversationLog {
  id         String @id @default(uuid())
  agentId    String
  agent      Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  instanceId String
  remoteJid  String

  userMessage      String @db.Text
  agentReply       String @db.Text

  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  totalTokens      Int @default(0)

  provider  String // OPENAI, CLAUDE, GEMINI (snapshot)
  model     String // gpt-4o, etc. (snapshot)

  toolCalls Json @default("[]") // [{ toolName, args, accessType }]

  // Prompt caching metrics (Anthropic / OpenAI report these)
  cachedTokens          Int @default(0)
  cacheCreationTokens   Int @default(0)

  createdAt DateTime @default(now())
}

// Rich, human-readable activity log for the Agent "Activity" tab.
// Distinct from AiConversationLog (which is used as the AI's long-term
// memory) — this one only keeps the last 3 days and gets pruned by a
// scheduled cleanup so we can store fuller payloads (tool args + results)
// without bloating the DB.
model AgentActivityLog {
  id          String @id @default(uuid())
  agentId     String
  agent       Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId String?

  instanceId    String
  remoteJid     String
  contactPhone  String?
  contactName   String?
  channel       String  @default("whatsapp") // 'whatsapp' | 'instagram'

  userMessage String  @db.Text
  agentReply  String  @db.Text

  // [{ toolName, args, result, durationMs, ok, error? }]
  // HTTP tool results carry { status, data } with body truncated to ~5kB.
  // Authorization headers and Bearer tokens are redacted before save.
  toolCalls Json @default("[]")

  durationMs Int @default(0)

  createdAt DateTime @default(now())

  @@index([agentId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([createdAt]) // used by the cleanup job
}

model CustomTable {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  columns     Json // Array of column definitions: { name: 'Price', type: 'number', relationTableId?: 'uuid' }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rows CustomRow[]
}

model CustomRow {
  id      String      @id @default(uuid())
  tableId String
  table   CustomTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  data Json // Key-value pairs matching table columns

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  phone   String // RemoteJid digits (WhatsApp) or IGSID (Instagram)
  name    String?
  status  String   @default("NEW") // Custom CRM Status e.g., "Lead", "Purchased"
  tags    String[]
  summary String?  @db.Text // AI-generated summary of interactions

  channel     String? // "whatsapp" | "instagram"
  sourceLabel String? // WhatsApp instance name or @instagram_username

  customFields Json? // Map<UserField.key, value> — values for user-defined fields

  // When true, the AI agent stops auto-replying to this contact's
  // incoming messages. Messages still get logged so the agent has
  // full memory after the human un-pauses.
  agentPaused      Boolean   @default(false)
  pausedAt         DateTime?

  // True when `phone` is actually a WhatsApp LID (anonymous identity)
  // rather than a real phone number. UI uses this to render a 🔒 badge
  // and hide the "+" prefix that would otherwise imply a phone number.
  isAnonymous      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, phone])
}

// Admin-defined custom field on the Client (contact) entity.
// Values are stored on Client.customFields keyed by `key`.
model UserField {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  key   String   // machine slug used as the customFields JSON key
  label String   // human label shown in the UI
  type  String   // 'text' | 'number' | 'date' | 'select' | 'boolean'
  options String[] @default([]) // only for type='select'
  order Int       @default(0)   // table column order

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId, order])
}

// -----------------------------------------
// Outbound Campaigns
// -----------------------------------------

model Campaign {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  agentId    String?
  agent      Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)

  instanceId String?
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  name       String
  status     String   @default("PENDING") // PENDING, RUNNING, PAUSED, COMPLETED, FAILED

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recipients CampaignRecipient[]
}

model CampaignRecipient {
  id         String    @id @default(uuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  phone      String
  remoteJid  String
  status     String    @default("PENDING") // PENDING, SENDING, SENT, FAILED, REPLIED
  sentAt     DateTime?
  repliedAt  DateTime?
  error      String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([campaignId, remoteJid])
}

// -----------------------------------------
// Instagram Integration
// -----------------------------------------

model InstagramAccount {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  igUserId    String  @unique // Instagram User ID from API
  igUsername   String  // @username
  accessToken String  @db.Text // Long-lived access token
  pageId      String? // Facebook Page ID (needed for some API calls)

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------
// Visual Automations (workflow builder)
// -----------------------------------------

model Automation {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name     String
  isActive Boolean @default(false)

  nodes Json @default("[]") // React Flow nodes: [{ id, type, position, data }]
  edges Json @default("[]") // React Flow edges: [{ id, source, target, sourceHandle }]

  executions AutomationExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── MCP (Model Context Protocol) ──────────────────────────────────
// Per-user OAuth clients (e.g. Claude Desktop) registered via DCR.
model McpClient {
  id           String   @id @default(uuid())
  userId       String?  // nullable until first authorize binds the client to a user
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId     String   @unique
  clientSecret String   // bcrypt hash; empty for public clients
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([workspaceId])
}

model McpOAuthToken {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId   String?
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId      String   // public OAuth client id (matches McpClient.clientId)
  accessToken   String   @unique
  refreshToken  String?  @unique
  expiresAt     DateTime
  scopes        String[]
  createdAt     DateTime @default(now())

  @@index([userId])
}

// Short-lived authorization codes issued during the PKCE flow.
model McpAuthCode {
  id                  String   @id @default(uuid())
  code                String   @unique
  userId              String
  workspaceId         String?
  clientId            String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String   // 'S256' | 'plain'
  scopes              String[]
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime @default(now())
}

model McpPermission {
  // Per-workspace tool allow/deny map. Empty / missing entry = allowed (default).
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?  @unique
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  toolFlags   Json     @default("{}")
  updatedAt   DateTime @updatedAt
}

model McpAuditLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authKind    String   // 'api_key' | 'oauth'
  authRef     String?
  tool        String
  argsJson    Json
  resultOk    Boolean
  errorMsg    String?  @db.Text
  durationMs  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
}

model AutomationExecution {
  id           String     @id @default(uuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  userId       String
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  status      String   // 'success' | 'failure'
  triggerType String   // node type that matched, e.g. 'trigger_ig_comment'
  channel     String   // 'whatsapp' | 'instagram'
  contactId   String
  contactName String?
  inputText   String?  @db.Text
  nodesExecuted Int    @default(0)
  durationMs   Int     @default(0)
  errorMessage String?  @db.Text

  startedAt   DateTime @default(now())

  @@index([automationId, startedAt(sort: Desc)])
}

// Cached profile of a person who messaged an Instagram business account
model InstagramContact {
  id         String   @id @default(uuid())
  igUserId   String   // the connected business account this contact wrote to
  senderId   String   // IGSID of the person messaging
  username   String?
  name       String?
  profilePic String?  @db.Text
  lastMessageAt DateTime? // last time this contact sent a message

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([igUserId, senderId])
}

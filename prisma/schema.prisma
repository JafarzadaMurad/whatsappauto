generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// System-wide config (Meta App credentials, etc.)
model SystemConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ─── Workspaces ──────────────────────────────────────────────────
// Every user owns a personal workspace and can be a member of other
// workspaces (e.g. invited by someone else). All "tenant" data
// (instances, automations, clients, etc.) is scoped by workspaceId.
model Workspace {
  id      String  @id @default(uuid())
  name    String
  ownerId String
  owner   User    @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Subscription + plan apply at the workspace level. Members of a
  // workspace use the owner's plan; their own plan is irrelevant inside
  // someone else's workspace.
  planId               String?
  plan                 Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptionStatus   String    @default("none") // none | trialing | active | past_due | canceled
  subscriptionEndsAt   DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  roles       WorkspaceRole[]

  instances         Instance[]
  webhooks          WebhookConfig[]
  apiKeys           ApiKey[]
  aiProviders       AiProvider[]
  agents            Agent[]
  customTables      CustomTable[]
  clients           Client[]
  campaigns         Campaign[]
  googleCalendar    GoogleCalendarConnection?
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  userFields        UserField[]
  automationExecutions AutomationExecution[]
  mcpClients     McpClient[]
  mcpOAuthTokens McpOAuthToken[]
  mcpPermission  McpPermission?
  mcpAuditLogs   McpAuditLog[]
  oversightAgents OversightAgent[]
  dashboardWidgets DashboardWidget[]
  operatorDirectives OperatorDirective[]
  agentChatMessages  AgentChatMessage[]
  adRoutes           AdRoute[]
  metaAdAccounts     MetaAdAccount[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Legacy role string — kept for the OWNER marker and as a fallback during
  // migration. New code reads `roleId` and resolves WorkspaceRole.permissions.
  role        String   @default("MEMBER") // OWNER | <custom role name>
  roleId      String?
  customRole  WorkspaceRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([roleId])
}

model WorkspaceInvitation {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String   @default("MEMBER")
  roleId      String?
  customRole  WorkspaceRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  token       String   @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([email])
  @@index([roleId])
}

// Owner-defined roles for a workspace. Each row carries a JSON permission
// matrix consumed by the auth middleware to gate every controller. The
// workspace creator is always implicit "Owner" via Workspace.ownerId and
// bypasses these checks; everyone else's access is the union of their
// role's flags.
model WorkspaceRole {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  description String?  @db.Text
  // Shape:
  // {
  //   sections: { inbox:{view,create,update,delete}, ... },
  //   chat:     { view, write },
  //   meta:     { manageRoles, inviteMembers, manageWorkspace }
  // }
  permissions Json     @default("{}")
  // System roles are seeded automatically (Admin / Member / Viewer) and
  // cannot be renamed or deleted, but their permissions may be edited.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// Subscription plans (managed by admins)
model Plan {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text

  price    Float  @default(0)      // amount per billing interval
  currency String @default("USD")
  interval String @default("month") // month | year

  // Resource limits (-1 = unlimited)
  maxAgents            Int @default(1)
  maxWhatsappAccounts  Int @default(1)
  maxInstagramAccounts Int @default(1)
  maxAutomations       Int @default(1)
  monthlyMessageLimit  Int @default(1000)

  isActive      Boolean @default(true)
  isDefault     Boolean @default(false) // assigned to new sign-ups (only one plan can be default; must have price = 0)
  trialDays     Int?    // duration of the free plan in days; null = no expiry

  stripePriceId String? // Stripe Price ID (set when billing is wired up)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  workspaces Workspace[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?  // null for users who signed in via Google
  name      String?
  role      String   @default("USER") // USER | ADMIN
  googleId  String?  @unique // Google "sub" claim for OAuth sign-in

  // Email verification + password reset
  emailVerified        Boolean   @default(false)
  emailVerifyToken     String?   @unique
  emailVerifyExpires   DateTime?
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Subscription
  planId               String?
  plan                 Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptionStatus   String    @default("none") // none | trialing | active | past_due | canceled
  subscriptionEndsAt   DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?

  instances Instance[]
  webhooks  WebhookConfig[]
  apiKeys   ApiKey[]

  // AI & CRM Links
  aiProviders  AiProvider[]
  agents       Agent[]
  customTables CustomTable[]
  clients      Client[]
  campaigns         Campaign[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  userFields        UserField[]

  // MCP
  mcpClients     McpClient[]
  mcpOAuthTokens McpOAuthToken[]
  mcpPermission  McpPermission?
  mcpAuditLogs   McpAuditLog[]

  // Workspaces
  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
}

model Instance {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  // Optional router agent — used as the first agent that talks to a
  // brand new contact. Its handoffTo tool then binds the contact to a
  // specialised agent via Client.assignedAgentId and the router
  // stops being called for that contact. When null, the conversation
  // goes straight to the primary agent above.
  routerAgentId String?
  routerAgent   Agent?  @relation("InstanceRouter", fields: [routerAgentId], references: [id], onDelete: SetNull)

  name        String
  status      String  @default("DISCONNECTED") // CONNECTED, DISCONNECTED, CONNECTING
  sessionData String? @db.Text // Can store some meta-info, actual baileys state might be stored elsewhere or here piece by piece

  // When true, on the next link/restart Baileys requests the full chat
  // history from the phone and we store the incoming messages.
  syncHistory Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]
  contacts  Contact[]
  webhooks  WebhookConfig[]
  campaigns Campaign[]
}

model ApiKey {
  id          String @id @default(uuid())
  key         String @unique
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model WebhookConfig {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  instanceId String? // Optional: if null applies to all, otherwise specific to instance
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  url      String
  events   String[] // e.g. ["message.new", "message.sent"]
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id         String   @id @default(uuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  remoteJid   String // The WhatsApp ID of the chat/contact
  isFromMe    Boolean
  messageType String // text, image, video, document, etc
  content     String? @db.Text

  // Media attachment, downloaded from WhatsApp into the local uploads
  // directory. mediaUrl is the path served by /api/uploads/files/...
  // (no auth; filenames are random hex). Empty for plain text messages.
  mediaUrl  String?
  mediaMime String?
  mediaName String?

  status String @default("SENT") // PENDING, SENT, DELIVERED, READ

  // WhatsApp message id (from Baileys msg.key.id). Used to match
  // delivery / read receipts to the original row.
  waMsgId String?

  // When the operator opened the conversation and we marked inbound
  // messages as read. Null while still unread.
  readAt DateTime?

  // For interactive poll messages we send: the original Baileys
  // proto.IMessage struct (poll question + options + encKey) so we
  // can decrypt the customer's vote when the messages.update event
  // fires. Null for every other message type.
  pollPayload Json?

  // Links a reply / reaction / poll-vote message back to the row it
  // refers to. Set to the parent's waMsgId. The inbox UI uses this
  // to render replies (and aggregate poll votes) under the original
  // message instead of as separate bubbles.
  inReplyToWaMsgId String?

  // Click-to-WhatsApp ad metadata that arrived with this message.
  // Pulled from Baileys' message.contextInfo.externalAdReply when the
  // customer reached us by tapping a Facebook/Instagram ad. Shape:
  //   { sourceUrl, title, body, mediaType, ctwaClid, sourceType, sourceId,
  //     thumbnailUrl }
  // Null on every message that didn't come via an ad click.
  adReferrer Json?

  timestamp DateTime
  createdAt DateTime @default(now())

  @@index([instanceId, remoteJid, readAt])
  @@index([instanceId, waMsgId])
}

model Contact {
  id         String   @id @default(uuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  remoteJid String
  name      String?
  pushName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instanceId, remoteJid])
}

// Maps a WhatsApp LID (anonymous identity like 231610725195937@lid) to
// the real phone JID the contact also uses. WhatsApp delivers `senderPn`
// on some messages from LID-only contacts — when we see one we cache
// the mapping here so subsequent messages, the inbox merge step, and
// the CRM can all route to the real phone instead of leaving two
// duplicate conversations side by side.
model LidMapping {
  id         String   @id @default(uuid())
  instanceId String
  lid        String   // e.g. "231610725195937@lid"
  phone      String   // digits only, e.g. "994773102993"
  createdAt  DateTime @default(now())

  @@unique([instanceId, lid])
  @@index([instanceId, phone])
}

// Model for Baileys Auth State
model AuthState {
  id         String   @id @default(uuid())
  instanceId String   @unique
  data       String   @db.Text // JSON string containing creds
  updatedAt  DateTime @updatedAt
}

model AuthKey {
  id         String   @id // Formatted as instanceId_type_id
  instanceId String
  type       String
  keyId      String
  data       String   @db.Text // JSON string containing the key
  updatedAt  DateTime @updatedAt

  @@unique([instanceId, type, keyId])
}

// -----------------------------------------
// AI Chatbot & Intelligent CRM CRM Models
// -----------------------------------------

model AiProvider {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  provider String // OPENAI, CLAUDE, GEMINI
  apiKey   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agents Agent[]
  oversightAgents OversightAgent[]

  @@unique([userId, provider])
  @@index([workspaceId])
}

model Agent {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name       String
  providerId String
  provider   AiProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  model      String // e.g. "gpt-4o", "claude-3-opus"

  systemPrompt    String?  @db.Text
  allowedTableIds String[] // IDs of CustomTable models this agent can access
  skills          String[] // e.g. ["crm", "tables", "http", "memory"]
  allowedUrls     String[] // URL patterns the generic httpRequest tool can call
  httpTools       Json     @default("[]") // Array of HttpToolTemplate (n8n-style structured HTTP tools)
  skillPrompts    Json     @default("{}") // Per-skill prompt overrides: { memory?: string, crm?: string, ... }
  isActive        Boolean  @default(true)
  // Multi-modal toggles. audioEnabled + an OpenAI provider key in the
  // workspace ⇒ incoming voice notes are transcribed via Whisper.
  // visionEnabled + a vision-capable model ⇒ incoming photos are
  // forwarded as a native image part. Both default to on.
  audioEnabled    Boolean  @default(true)
  visionEnabled   Boolean  @default(true)
  // Whisper language hint. ISO 639-1 ("az", "ru", "tr", "en", ...).
  // Null = let Whisper auto-detect (often wrong for short non-English
  // clips). Setting this dramatically improves transcription quality
  // when the customer base speaks a known language.
  whisperLanguage String?
  // OpenAI speech-to-text model. One of:
  //   whisper-1               — classic, cheapest, broadest format
  //   gpt-4o-transcribe       — newer, higher accuracy
  //   gpt-4o-mini-transcribe  — cheaper newer model
  // Default is whisper-1 because it's the most permissive about input
  // formats (webm/ogg/m4a all work).
  whisperModel    String   @default("whisper-1")
  // IANA timezone used to render {{date}}/{{day}}/{{time}} placeholders
  // in the system prompt at each turn. Defaults to UTC so a fresh agent
  // still works; the editor exposes a country/timezone picker.
  timezone        String   @default("UTC")
  // Sticky routing. isRouter=true marks this agent as a dispatcher —
  // it gets the handoffTo + unassignAgent tools and is allowed to be
  // selected as Instance.routerAgentId. routerDescription is a short
  // text the router sees in its tool's enum so it knows when to pick
  // each sibling ("Handles laser cutting orders and quote requests").
  isRouter           Boolean @default(false)
  routerDescription  String?
  // For router agents: explicit allow-list of agent ids this router
  // is allowed to dispatch to. Empty array = unset (back-compat: any
  // workspace sibling is allowed). Owner manages this from the
  // Router Agents page.
  routableAgentIds   String[] @default([])

  instancesAsRouter Instance[] @relation("InstanceRouter")
  igAccountsAsRouter InstagramAccount[] @relation("InstagramRouter")
  assignedClients   Client[]   @relation("ClientAssignedAgent")
  // How many recent messages the agent sees on each turn. Smaller
  // windows force the model to use the memory tools for older context
  // (cheaper tokens, slower lookups); larger windows give it more
  // context for free. Default 10 — comfortable middle ground.
  historyDepth    Int      @default(10)
  // Auto-reminder skill setting. Used only when 'reminder' is in
  // `skills`. The background scheduler picks contacts where the
  // last inbound message is older than this many hours and asks the
  // model to draft a re-engagement message based on chat history.
  reminderHours   Int      @default(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instances         Instance[] // Instances using this agent
  conversationLogs  AiConversationLog[]
  activityLogs      AgentActivityLog[]
  campaigns         Campaign[]
  instagramAccounts InstagramAccount[]
  operators         Operator[]
  operatorRequests  OperatorRequest[]
  oversightWatches  OversightAgentWatch[]
  oversightSuggestions OversightSuggestion[]
  operatorDirectives OperatorDirective[]
  agentChatMessages  AgentChatMessage[]
  adRoutes           AdRoute[]
}

// Facebook ad account connected via OAuth. One workspace can connect
// multiple ad accounts (large businesses run several from the same
// Business Manager). The accessToken is a long-lived FB user token —
// usable for ~60 days, after which the operator must reconnect.
//
// Stored fields:
//  · fbUserId / fbUserName — who granted access, for the UI
//  · accessToken           — used on every Marketing API call
//  · tokenExpiresAt        — when to start showing the "reconnect" CTA
//  · adAccountId           — Meta's "act_XXXXXXX" form
//  · accountName, currency — cached for fast UI render without a roundtrip
//  · lastError             — last sync error, surfaced inline so the
//                            operator can see WHY the account stopped
model MetaAdAccount {
  id              String   @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  fbUserId        String?
  fbUserName      String?
  accessToken     String   @db.Text
  tokenExpiresAt  DateTime?

  adAccountId     String
  accountName     String
  currency        String?

  status          String   @default("active")
  lastError       String?
  lastSyncedAt    DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  metaAds         MetaAd[]

  @@unique([workspaceId, adAccountId])
}

// Lazy-populated cache of Meta ad → adset → campaign hierarchy.
// Used at runtime so a click-to-WhatsApp arrival (which only carries
// the ad id in externalAdReply.sourceId) can be routed against
// campaign-level or adset-level AdRoute rules. Upserted on every
// /meta/accounts/:id/ads call.
model MetaAd {
  id              String   @id @default(uuid())
  metaAdAccountId String
  metaAdAccount   MetaAdAccount @relation(fields: [metaAdAccountId], references: [id], onDelete: Cascade)

  adId            String   @unique
  name            String?
  adsetId         String?
  adsetName       String?
  campaignId      String?
  campaignName    String?
  status          String?
  effectiveStatus String?
  thumbnailUrl    String?
  createdTime     DateTime?
  lastSyncedAt    DateTime?

  @@index([metaAdAccountId])
  @@index([campaignId])
  @@index([adsetId])
}

// Oversight ("meta") agent — periodically reviews one or more
// production agents' prompt, skills, recent customer + operator
// conversations and produces a structured list of suggestions.
// Applicable suggestions carry a payload that lets the operator
// approve-and-apply with a single click; info_note ones are just
// for awareness. One oversight can watch many agents (a single
// "QA model" reviews the whole team).
model OversightAgent {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  description String?    @db.Text

  providerId String
  provider   AiProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  model      String

  systemPrompt String? @db.Text

  intervalDays  Int @default(3)  // run every N days
  runHour       Int @default(9)  // local hour 0–23 to fire at
  lookbackDays  Int @default(3)  // span of customer activity to load per run

  isActive  Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  watches     OversightAgentWatch[]
  runs        OversightRun[]
  suggestions OversightSuggestion[]

  @@index([workspaceId])
  @@index([isActive, nextRunAt])
}

model OversightAgentWatch {
  id               String         @id @default(uuid())
  oversightAgentId String
  oversightAgent   OversightAgent @relation(fields: [oversightAgentId], references: [id], onDelete: Cascade)
  agentId          String
  agent            Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([oversightAgentId, agentId])
  @@index([agentId])
}

model OversightRun {
  id               String         @id @default(uuid())
  oversightAgentId String
  oversightAgent   OversightAgent @relation(fields: [oversightAgentId], references: [id], onDelete: Cascade)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running") // running | completed | failed
  errorMsg   String?   @db.Text

  suggestionsCount Int     @default(0)
  summary          String? @db.Text // one-line overall verdict for the dashboard
  tokensIn         Int     @default(0)
  tokensOut        Int     @default(0)

  suggestions OversightSuggestion[]

  @@index([oversightAgentId, startedAt(sort: Desc)])
}

model OversightSuggestion {
  id               String         @id @default(uuid())
  oversightAgentId String
  oversightAgent   OversightAgent @relation(fields: [oversightAgentId], references: [id], onDelete: Cascade)
  runId            String?
  run              OversightRun?  @relation(fields: [runId], references: [id], onDelete: SetNull)

  targetAgentId String
  targetAgent   Agent  @relation(fields: [targetAgentId], references: [id], onDelete: Cascade)

  // type drives the apply path:
  //   prompt_append / prompt_replace → mutate target Agent.systemPrompt
  //   add_table_row                  → append a row to a CustomTable
  //   add_http_tool                  → append a new HttpToolTemplate to target Agent.httpTools
  //   enable_skill / disable_skill   → flip a key on Agent.skills
  //   info_note                      → operator-only insight, applicable=false
  type        String
  title       String
  description String  @db.Text
  payload     Json?

  applicable Boolean @default(false) // true → can be approved + auto-applied
  status     String  @default("pending") // pending | approved | rejected | applied | apply_failed

  readAt     DateTime?
  reviewedAt DateTime?
  reviewedBy String?
  appliedAt  DateTime?
  applyError String?  @db.Text

  createdAt DateTime @default(now())

  @@index([oversightAgentId, status])
  @@index([targetAgentId, status])
  @@index([status, createdAt])
}

// Live operator — a human teammate the agent can ping over WhatsApp
// when it needs domain expertise (pricing, escrow rules, special
// approvals). The agent uses askOperator({operatorId, question}) to
// fire a question; the operator's reply is routed back to the
// originating customer's conversation. Ordering controls the fallback
// queue when the first operator times out.
model Operator {
  id           String  @id @default(uuid())
  agentId      String
  agent        Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId  String?

  name         String
  phone        String  // digits only, e.g. "994551234567"
  systemPrompt String? @db.Text // role context (e.g. "You handle pricing and stock")
  order        Int     @default(0) // lower = tried first when escalating
  timeoutMin   Int     @default(30) // forward to next operator after this many minutes
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests OperatorRequest[]

  @@unique([agentId, phone])
  @@index([agentId, order])
  @@index([phone])
}

// One pending question from the agent to an operator about a specific
// customer. The agent embeds the 5-char ticket code in the outgoing
// WhatsApp message; the operator's reply is matched back by ticket,
// quoted-message scan, or "single open ticket" fallback. status
// transitions: open → answered (delivered to customer) | timeout
// (escalated to next operator) | cancelled.
model OperatorRequest {
  id          String  @id @default(uuid())
  ticket      String  @unique // 5-char code, e.g. "A7K2X"
  agentId     String
  agent       Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId String?
  instanceId  String  // WhatsApp instance handling the customer

  // Customer who triggered the question
  customerJid   String
  customerName  String?
  customerPhone String?

  // Operator currently holding the request
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  question String  @db.Text
  answer   String? @db.Text

  status         String   @default("open") // open | answered | timeout | cancelled
  attemptedOpIds String[] @default([])    // operators that already saw + timed out

  sentAt     DateTime  @default(now())
  answeredAt DateTime?
  timeoutAt  DateTime  // when the periodic checker should escalate

  @@index([agentId, status])
  @@index([operatorId, status])
  @@index([timeoutAt])
  @@index([customerJid, status])
}

model AiConversationLog {
  id         String @id @default(uuid())
  agentId    String
  agent      Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  instanceId String
  remoteJid  String

  userMessage      String @db.Text
  agentReply       String @db.Text

  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  totalTokens      Int @default(0)

  provider  String // OPENAI, CLAUDE, GEMINI (snapshot)
  model     String // gpt-4o, etc. (snapshot)

  toolCalls Json @default("[]") // [{ toolName, args, accessType }]

  // Prompt caching metrics (Anthropic / OpenAI report these)
  cachedTokens          Int @default(0)
  cacheCreationTokens   Int @default(0)

  createdAt DateTime @default(now())
}

// Rich, human-readable activity log for the Agent "Activity" tab.
// Distinct from AiConversationLog (which is used as the AI's long-term
// memory) — this one only keeps the last 3 days and gets pruned by a
// scheduled cleanup so we can store fuller payloads (tool args + results)
// without bloating the DB.
model AgentActivityLog {
  id          String @id @default(uuid())
  agentId     String
  agent       Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId String?

  instanceId    String
  remoteJid     String
  contactPhone  String?
  contactName   String?
  channel       String  @default("whatsapp") // 'whatsapp' | 'instagram'

  userMessage String  @db.Text
  agentReply  String  @db.Text

  // [{ toolName, args, result, durationMs, ok, error? }]
  // HTTP tool results carry { status, data } with body truncated to ~5kB.
  // Authorization headers and Bearer tokens are redacted before save.
  toolCalls Json @default("[]")

  durationMs Int @default(0)

  createdAt DateTime @default(now())

  @@index([agentId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([createdAt]) // used by the cleanup job
}

model CustomTable {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  columns     Json // Array of column definitions: { name: 'Price', type: 'number', relationTableId?: 'uuid' }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rows CustomRow[]
}

model CustomRow {
  id      String      @id @default(uuid())
  tableId String
  table   CustomTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  data Json // Key-value pairs matching table columns

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  phone   String // RemoteJid digits (WhatsApp) or IGSID (Instagram)
  name    String?
  status  String   @default("NEW") // Custom CRM Status e.g., "Lead", "Purchased"
  tags    String[]
  summary String?  @db.Text // AI-generated summary of interactions

  channel     String? // "whatsapp" | "instagram"
  sourceLabel String? // WhatsApp instance name or @instagram_username

  customFields Json? // Map<UserField.key, value> — values for user-defined fields

  // When true, the AI agent stops auto-replying to this contact's
  // incoming messages. Messages still get logged so the agent has
  // full memory after the human un-pauses.
  agentPaused      Boolean   @default(false)
  pausedAt         DateTime?

  // Sticky routing pointer. Set by the router agent's handoffTo tool
  // when a new contact picks a topic. Future messages from this
  // contact go straight to the assigned agent, skipping the router.
  // Null = let the router (or the instance's primary agent) decide.
  assignedAgentId  String?
  assignedAgent    Agent?    @relation("ClientAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  // True when `phone` is actually a WhatsApp LID (anonymous identity)
  // rather than a real phone number. UI uses this to render a 🔒 badge
  // and hide the "+" prefix that would otherwise imply a phone number.
  isAnonymous      Boolean   @default(false)

  // Cached profile-picture URL (WhatsApp media CDN). Refreshed lazily
  // when older than 24h so we don't hammer Baileys on every message.
  profilePicUrl       String?
  profilePicUpdatedAt DateTime?

  // Last time the auto-reminder skill sent a re-engagement message to
  // this contact. Used as a per-contact lock so the scheduler doesn't
  // re-ping the same idle conversation on every sweep.
  lastReminderAt      DateTime?

  // Inbox operator → AI agent directives ("be friendlier", "push this
  // to Bitrix", etc.). Persistent ones get re-injected into the agent
  // context on every turn; one-shots are consumed on the next reply.
  operatorDirectives  OperatorDirective[]
  agentChatMessages   AgentChatMessage[]

  // Click-to-WhatsApp first-touch attribution: the ad metadata
  // captured the first time we saw this contact arrive via an
  // externalAdReply. Same shape as Message.adReferrer. Lets the ads
  // analytics page group contacts by source ad without scanning
  // every Message row, and lets the ad-routing rule lock the agent
  // on first contact.
  adReferrer Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, phone])
}

// Operator → AI-agent steering message sent from the inbox while the
// agent is handling a contact. `persistent: true` rows stay in effect
// until the operator clears them and get injected as system context on
// every subsequent agent turn for this contact; `persistent: false`
// rows fire once and are consumed by the very next reply.
model OperatorDirective {
  id          String  @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentId     String
  agent       Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  text        String  @db.Text
  persistent  Boolean @default(true)
  // 'chat' = free-text from operator panel; 'quick_action' = canned
  // chip (used for the audit log and to colour them differently).
  source      String  @default("chat")

  // Set when the operator hits "Run now" — picked up by the directive
  // ingest path so we know to fire the agent without waiting for the
  // customer's next message. Cleared on consumption.
  triggerNow  Boolean @default(false)

  // Once a one-shot directive has been injected into a turn, mark it
  // consumed instead of deleting (keeps the audit trail).
  consumedAt  DateTime?

  createdAt   DateTime @default(now())

  @@index([clientId, agentId, consumedAt])
}

// Operator ⇄ AI-agent chat backing the "Talk to agent" panel. The
// operator types instructions in plain language ("send him hi",
// "be friendlier going forward", "push to Bitrix") and the agent
// decides itself whether to (a) message the customer via the
// sendToCustomer tool, (b) persist a steering note via
// addSteeringNote, or (c) call any of its normal skills (CRM,
// HTTP, etc.). The agent's text reply lands here, NOT in the
// customer chat — this gives the operator a private back-channel.
model AgentChatMessage {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  role        String   // 'operator' | 'agent'
  text        String   @db.Text
  // Structured tool-call summary for display in the panel:
  // [{ name: 'sendToCustomer', args: {...}, ok: true }, ...]. Null
  // for plain operator messages.
  toolCalls   Json?

  createdAt   DateTime @default(now())

  @@index([clientId, agentId, createdAt])
}

// Routes click-to-WhatsApp ad clicks to a specific agent. Lets one
// WhatsApp number host many ads, each handed off to its own agent
// based on what the customer just clicked. Matched on first contact
// only — once an agent is assigned (Client.assignedAgentId), the
// sticky assignment wins on subsequent messages.
//
// matchType  → what part of externalAdReply we test:
//   'headline'    — case-insensitive substring of externalAdReply.title
//   'source_url'  — case-insensitive substring of externalAdReply.sourceUrl
//   'ad_id'       — exact externalAdReply.sourceId (Meta's ad-creative id)
//   'ctwa_prefix' — externalAdReply.ctwaClid startsWith (campaigns
//                   sometimes encode an id prefix in the click token)
//
// priority   → highest wins. Within the same priority, oldest rule
//              wins so the operator can predictably layer rules.
model AdRoute {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String   // human label, e.g. "Türkiyə əmlakı kampaniyası"
  matchType   String   // see comment above
  matchValue  String   // the literal substring / id / prefix to test

  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  priority    Int      @default(0)
  isActive    Boolean  @default(true)

  // Bookkeeping so the UI can show "this rule fired 47 times".
  hitCount    Int      @default(0)
  lastHitAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, isActive, priority])
}

// Admin-defined custom field on the Client (contact) entity.
// Values are stored on Client.customFields keyed by `key`.
model UserField {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  key   String   // machine slug used as the customFields JSON key
  label String   // human label shown in the UI
  type  String   // 'text' | 'number' | 'date' | 'select' | 'boolean'
  options String[] @default([]) // only for type='select'
  order Int       @default(0)   // table column order

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId, order])
}

// -----------------------------------------
// Outbound Campaigns
// -----------------------------------------

model Campaign {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  agentId    String?
  agent      Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)

  instanceId String?
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  name       String
  status     String   @default("PENDING") // PENDING, RUNNING, PAUSED, COMPLETED, FAILED

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recipients CampaignRecipient[]
}

model CampaignRecipient {
  id         String    @id @default(uuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  phone      String
  remoteJid  String
  status     String    @default("PENDING") // PENDING, SENDING, SENT, FAILED, REPLIED
  sentAt     DateTime?
  repliedAt  DateTime?
  error      String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([campaignId, remoteJid])
}

// -----------------------------------------
// Instagram Integration
// -----------------------------------------

model InstagramAccount {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  igUserId    String  @unique // Instagram User ID from API
  igUsername   String  // @username
  accessToken String  @db.Text // Long-lived access token
  pageId      String? // Facebook Page ID (needed for some API calls)

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  // Optional router agent — same pattern as Instance.routerAgentId.
  // When set, a brand-new IG contact talks to the router first; the
  // router's handoffTo binds them to a specialised AI agent.
  routerAgentId String?
  routerAgent   Agent?  @relation("InstagramRouter", fields: [routerAgentId], references: [id], onDelete: SetNull)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  InstagramComment[]
}

// Instagram post comments captured from the webhook. Comments live
// in their own table so the inbox can render them separately from
// DMs (which stay in AiConversationLog + Message). The AI agent on
// an IG account is now DM-only; comment handling is driven by the
// Automation engine + a future "AI reply to comment" node that
// operators wire up per-post if they want automation.
model InstagramComment {
  id             String   @id @default(uuid())
  igAccountId    String
  igAccount      InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  workspaceId    String?

  commentId      String   @unique  // Meta's IG comment id
  parentId       String?  // parent comment id when this is a reply
  mediaId        String?  // post / reel / story id the comment sits on
  mediaPermalink String?  // cached at capture time so the UI can link

  fromId         String   // commenter's IGSID
  fromUsername   String?

  text           String   @db.Text

  // What we did about it. AUTOMATION_MATCHED = an automation
  // reply / DM fired for it; MANUAL_REPLIED = operator replied
  // from the inbox; IGNORED = operator marked no-op; PENDING =
  // fresh, no action yet.
  status         String   @default("PENDING")
  agentReply     String?  // stored copy of whatever we ultimately sent as a public comment reply

  createdAt      DateTime @default(now())
  repliedAt      DateTime?

  @@index([igAccountId, createdAt])
  @@index([mediaId])
  @@index([status])
}

// -----------------------------------------
// Visual Automations (workflow builder)
// -----------------------------------------

model Automation {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name     String
  isActive Boolean @default(false)

  nodes Json @default("[]") // React Flow nodes: [{ id, type, position, data }]
  edges Json @default("[]") // React Flow edges: [{ id, source, target, sourceHandle }]

  executions AutomationExecution[]
  waitStates AutomationWaitState[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── MCP (Model Context Protocol) ──────────────────────────────────
// Per-user OAuth clients (e.g. Claude Desktop) registered via DCR.
model McpClient {
  id           String   @id @default(uuid())
  userId       String?  // nullable until first authorize binds the client to a user
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId     String   @unique
  clientSecret String   // bcrypt hash; empty for public clients
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([workspaceId])
}

model McpOAuthToken {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId   String?
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId      String   // public OAuth client id (matches McpClient.clientId)
  accessToken   String   @unique
  refreshToken  String?  @unique
  expiresAt     DateTime
  scopes        String[]
  createdAt     DateTime @default(now())

  @@index([userId])
}

// Short-lived authorization codes issued during the PKCE flow.
model McpAuthCode {
  id                  String   @id @default(uuid())
  code                String   @unique
  userId              String
  workspaceId         String?
  clientId            String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String   // 'S256' | 'plain'
  scopes              String[]
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime @default(now())
}

model McpPermission {
  // Per-workspace tool allow/deny map. Empty / missing entry = allowed (default).
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?  @unique
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  toolFlags   Json     @default("{}")
  updatedAt   DateTime @updatedAt
}

model McpAuditLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authKind    String   // 'api_key' | 'oauth'
  authRef     String?
  tool        String
  argsJson    Json
  resultOk    Boolean
  errorMsg    String?  @db.Text
  durationMs  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
}

model AutomationExecution {
  id           String     @id @default(uuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  userId       String
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  status      String   // 'success' | 'failure'
  triggerType String   // node type that matched, e.g. 'trigger_ig_comment'
  channel     String   // 'whatsapp' | 'instagram'
  contactId   String
  contactName String?
  inputText   String?  @db.Text
  nodesExecuted Int    @default(0)
  durationMs   Int     @default(0)
  errorMessage String?  @db.Text

  startedAt   DateTime @default(now())

  @@index([automationId, startedAt(sort: Desc)])
}

// Pauses an automation graph mid-run while it waits for a specific
// quick-reply reply from the contact. When they message back with a
// matching button label, the engine resumes from the edge that came
// off that button's handle. Rows are single-active-per-channel-per-contact.
model AutomationWaitState {
  id           String   @id @default(uuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  channel      String   // 'instagram' | 'whatsapp'
  contactId    String   // IGSID or WA remoteJid
  nodeId       String   // the node that emitted the quick replies
  buttons      Json     // [{ title, target }] — target is the next-node id off this button's edge
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([channel, contactId])
  @@index([expiresAt])
}

// Per-workspace Google Calendar connection. Populated after the OAuth
// flow completes; the refreshToken is long-lived and exchanged for a
// short-lived access token on every calendar API call. One connection
// per workspace — pick one calendar (default `primary`) as the target
// for the AI agent's schedule/book skill.
model GoogleCalendarConnection {
  id            String   @id @default(uuid())
  workspaceId   String   @unique
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedById String   // user who ran the OAuth flow (audit trail)
  email         String   // Google account email the tokens belong to
  refreshToken  String   @db.Text
  calendarId    String   @default("primary")
  scopes        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Cached profile of a person who messaged an Instagram business account
model InstagramContact {
  id         String   @id @default(uuid())
  igUserId   String   // the connected business account this contact wrote to
  senderId   String   // IGSID of the person messaging
  username   String?
  name       String?
  profilePic String?  @db.Text
  lastMessageAt DateTime? // last time this contact sent a message

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([igUserId, senderId])
}

// Pinned analytics widget. Each row is a saved analytics query the
// owner has parked on the Dashboard page; the renderer feeds `metric`
// + `filters` + `groupBy` to /api/analytics/query and draws the result
// using `visualType`. Layout order is `position` ascending.
model DashboardWidget {
  id          String     @id @default(uuid())
  userId      String
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title       String
  metric      String     // funnel | daily_volume | channel_split | tag_conversion | agent_perf | drop_off
  filters     Json       @default("{}")    // { from?, to?, status?, tags?, channel?, agentId?, customField? }
  groupBy     String?
  visualType  String     // kpi | line | bar | table | funnel
  position    Int        @default(0)
  size        String     @default("md")    // sm | md | lg

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workspaceId, position])
}

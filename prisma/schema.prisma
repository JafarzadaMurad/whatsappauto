generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// System-wide config (Meta App credentials, etc.)
model SystemConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Subscription plans (managed by admins)
model Plan {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text

  price    Float  @default(0)      // amount per billing interval
  currency String @default("USD")
  interval String @default("month") // month | year

  // Resource limits (-1 = unlimited)
  maxAgents            Int @default(1)
  maxWhatsappAccounts  Int @default(1)
  maxInstagramAccounts Int @default(1)
  maxAutomations       Int @default(1)
  monthlyMessageLimit  Int @default(1000)

  isActive      Boolean @default(true)
  isDefault     Boolean @default(false) // assigned to new sign-ups (only one plan can be default; must have price = 0)
  trialDays     Int?    // duration of the free plan in days; null = no expiry

  stripePriceId String? // Stripe Price ID (set when billing is wired up)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?  // null for users who signed in via Google
  name      String?
  role      String   @default("USER") // USER | ADMIN
  googleId  String?  @unique // Google "sub" claim for OAuth sign-in

  // Email verification + password reset
  emailVerified        Boolean   @default(false)
  emailVerifyToken     String?   @unique
  emailVerifyExpires   DateTime?
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Subscription
  planId               String?
  plan                 Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptionStatus   String    @default("none") // none | trialing | active | past_due | canceled
  subscriptionEndsAt   DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?

  instances Instance[]
  webhooks  WebhookConfig[]
  apiKeys   ApiKey[]

  // AI & CRM Links
  aiProviders  AiProvider[]
  agents       Agent[]
  customTables CustomTable[]
  clients      Client[]
  campaigns         Campaign[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
}

model Instance {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  name        String
  status      String  @default("DISCONNECTED") // CONNECTED, DISCONNECTED, CONNECTING
  sessionData String? @db.Text // Can store some meta-info, actual baileys state might be stored elsewhere or here piece by piece

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]
  contacts  Contact[]
  webhooks  WebhookConfig[]
  campaigns Campaign[]
}

model ApiKey {
  id     String @id @default(uuid())
  key    String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model WebhookConfig {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  instanceId String? // Optional: if null applies to all, otherwise specific to instance
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  url      String
  events   String[] // e.g. ["message.new", "message.sent"]
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id         String   @id @default(uuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  remoteJid   String // The WhatsApp ID of the chat/contact
  isFromMe    Boolean
  messageType String // text, image, video, document, etc
  content     String? @db.Text

  status String @default("SENT") // PENDING, SENT, DELIVERED, READ

  timestamp DateTime
  createdAt DateTime @default(now())
}

model Contact {
  id         String   @id @default(uuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  remoteJid String
  name      String?
  pushName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instanceId, remoteJid])
}

// Model for Baileys Auth State
model AuthState {
  id         String   @id @default(uuid())
  instanceId String   @unique
  data       String   @db.Text // JSON string containing creds
  updatedAt  DateTime @updatedAt
}

model AuthKey {
  id         String   @id // Formatted as instanceId_type_id
  instanceId String
  type       String
  keyId      String
  data       String   @db.Text // JSON string containing the key
  updatedAt  DateTime @updatedAt

  @@unique([instanceId, type, keyId])
}

// -----------------------------------------
// AI Chatbot & Intelligent CRM CRM Models
// -----------------------------------------

model AiProvider {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider String // OPENAI, CLAUDE, GEMINI
  apiKey   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agents Agent[]

  @@unique([userId, provider])
}

model Agent {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  providerId String
  provider   AiProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  model      String // e.g. "gpt-4o", "claude-3-opus"

  systemPrompt    String?  @db.Text
  allowedTableIds String[] // IDs of CustomTable models this agent can access
  skills          String[] // e.g. ["crm", "tables", "http", "memory"]
  allowedUrls     String[] // URL patterns the generic httpRequest tool can call
  httpTools       Json     @default("[]") // Array of HttpToolTemplate (n8n-style structured HTTP tools)
  skillPrompts    Json     @default("{}") // Per-skill prompt overrides: { memory?: string, crm?: string, ... }
  isActive        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instances         Instance[] // Instances using this agent
  conversationLogs  AiConversationLog[]
  campaigns         Campaign[]
  instagramAccounts InstagramAccount[]
}

model AiConversationLog {
  id         String @id @default(uuid())
  agentId    String
  agent      Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  instanceId String
  remoteJid  String

  userMessage      String @db.Text
  agentReply       String @db.Text

  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  totalTokens      Int @default(0)

  provider  String // OPENAI, CLAUDE, GEMINI (snapshot)
  model     String // gpt-4o, etc. (snapshot)

  toolCalls Json @default("[]") // [{ toolName, args, accessType }]

  // Prompt caching metrics (Anthropic / OpenAI report these)
  cachedTokens          Int @default(0)
  cacheCreationTokens   Int @default(0)

  createdAt DateTime @default(now())
}

model CustomTable {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  columns     Json // Array of column definitions: { name: 'Price', type: 'number', relationTableId?: 'uuid' }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rows CustomRow[]
}

model CustomRow {
  id      String      @id @default(uuid())
  tableId String
  table   CustomTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  data Json // Key-value pairs matching table columns

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone   String // RemoteJid digits (WhatsApp) or IGSID (Instagram)
  name    String?
  status  String   @default("NEW") // Custom CRM Status e.g., "Lead", "Purchased"
  tags    String[]
  summary String?  @db.Text // AI-generated summary of interactions

  channel     String? // "whatsapp" | "instagram"
  sourceLabel String? // WhatsApp instance name or @instagram_username

  customFields Json? // Additional CRM data AI extracts or user defines

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, phone])
}

// -----------------------------------------
// Outbound Campaigns
// -----------------------------------------

model Campaign {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)

  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Restrict)

  name       String
  status     String   @default("PENDING") // PENDING, RUNNING, PAUSED, COMPLETED, FAILED

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recipients CampaignRecipient[]
}

model CampaignRecipient {
  id         String    @id @default(uuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  phone      String
  remoteJid  String
  status     String    @default("PENDING") // PENDING, SENDING, SENT, FAILED, REPLIED
  sentAt     DateTime?
  repliedAt  DateTime?
  error      String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([campaignId, remoteJid])
}

// -----------------------------------------
// Instagram Integration
// -----------------------------------------

model InstagramAccount {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  igUserId    String  @unique // Instagram User ID from API
  igUsername   String  // @username
  accessToken String  @db.Text // Long-lived access token
  pageId      String? // Facebook Page ID (needed for some API calls)

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------
// Visual Automations (workflow builder)
// -----------------------------------------

model Automation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  isActive Boolean @default(false)

  nodes Json @default("[]") // React Flow nodes: [{ id, type, position, data }]
  edges Json @default("[]") // React Flow edges: [{ id, source, target, sourceHandle }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Cached profile of a person who messaged an Instagram business account
model InstagramContact {
  id         String   @id @default(uuid())
  igUserId   String   // the connected business account this contact wrote to
  senderId   String   // IGSID of the person messaging
  username   String?
  name       String?
  profilePic String?  @db.Text
  lastMessageAt DateTime? // last time this contact sent a message

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([igUserId, senderId])
}
